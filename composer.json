{
  "name": "roolith/database",
  "description": "PHP database driver",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Hadi",
      "email": "me@habibhadi.com"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.2",
    "fakerphp/faker": "^1.24"
  },
  "autoload": {
    "psr-4": {
      "Roolith\\Store\\": "src/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit --testdox tests",
    "coverage": "phpdbg -qrr vendor/bin/phpunit --coverage-html coverage-html --coverage-text tests",
    "coverage:clover": "phpdbg -qrr vendor/bin/phpunit --coverage-clover coverage.xml --coverage-text tests"
  },
  "version": "2.0.0"
}
